# Payment gateway (used only by /api/create-payment-order.js — server-side, secret)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Note: SUPABASE_URL and SUPABASE_ANON_KEY are NOT set here.
# They go directly in public/config.js since the anon key is meant to be
# public — Row Level Security in Supabase controls what it can access.
